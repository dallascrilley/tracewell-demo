---
import '../styles/tracewell.css';
const title = "Tracewell — Your agent failed in production. Here's the black box.";
const description = "The flight recorder for AI agents. Every tool call, every token, every prompt — and the one diff that broke it.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
  </head>
  <body style="background:oklch(15% 0.012 250);color:oklch(93% 0.008 250);">
    <div class="tw-root tw-shell" id="tw-app">
      <nav class="tw-nav" aria-label="Tracewell navigation">
        <span class="tw-nav-logo">tracewell</span>
        <span class="tw-nav-sep" aria-hidden="true"></span>
        <span class="tw-nav-label">Agent Run Explorer</span>
        <span class="tw-nav-spacer"></span>
        <button class="tw-nav-import" id="tw-import-toggle" aria-expanded="false" aria-controls="tw-import-panel">Analyze your trace</button>
        <span class="tw-nav-badge tw-nav-badge--live">live backend</span>
        <span class="tw-nav-badge" id="tw-mode-badge">synthetic · demo</span>
      </nav>

      <div class="tw-import-panel tw-hidden" id="tw-import-panel" role="region" aria-label="Analyze an agent-run trace">
        <div class="tw-import-head">
          <strong>Diagnose your own agent trace.</strong>
          Paste or upload a recorded run trace. The server classifies failure modes and returns a fix from <em>your</em> trace. Nothing is stored.
        </div>
        <div class="tw-import-controls">
          <label class="tw-import-filebtn">
            Choose JSON
            <input type="file" id="tw-import-file" accept=".json,application/json" hidden />
          </label>
          <button class="tw-import-btn" id="tw-import-sample" type="button">Load sample trace</button>
          <a class="tw-import-link" href="/data/sample-trace.json" download>Download sample</a>
        </div>
        <textarea id="tw-import-text" class="tw-import-text" rows="5" spellcheck="false"
          placeholder='Paste trace JSON: [{ "id", "agent_id", "status", "steps": [...] }]'></textarea>
        <div class="tw-import-actions">
          <button class="tw-import-btn tw-import-btn--primary" id="tw-import-analyze" type="button">Analyze trace</button>
          <span class="tw-import-status" id="tw-import-status" role="status"></span>
        </div>
      </div>

      <div class="tw-banner" id="tw-banner" role="status">
        <span class="tw-banner-icon">SYN</span>
        <p class="tw-banner-text">
          <strong>Every number here is synthetic — and honestly labeled.</strong>
          Default 50 runs are fabricated; token counts derive from real prompt lengths. Use <em>Analyze your trace</em> for the live backend.
        </p>
        <button class="tw-banner-dismiss" aria-label="Dismiss banner" id="tw-banner-dismiss">×</button>
      </div>

      <section class="tw-hero" id="tw-hero" aria-label="Top finding and run health">
        <article class="tw-hero-card" id="tw-hero-card" aria-live="polite">
          <div class="tw-hero-skeleton">Diagnosing runs…</div>
        </article>
        <aside class="tw-hero-rollup" id="tw-hero-rollup" aria-label="Run health rollup"></aside>
      </section>

      <div class="tw-scope" aria-hidden="true">
        <svg class="tw-scope-svg" viewBox="0 0 1200 36" preserveAspectRatio="none" focusable="false">
          <path class="tw-scope-line" d="M0 18 L120 18 L150 18 L162 6 L174 30 L186 9 L198 27 L210 18 L470 18 L500 18 L512 18 L524 4 L536 32 L548 18 L820 18 L850 18 L862 13 L874 23 L886 18 L1080 18 L1110 18 L1122 8 L1134 28 L1146 18 L1200 18" />
        </svg>
      </div>

      <div class="tw-layout" id="tw-layout">
        <aside class="tw-sidebar" aria-label="Failure clusters">
          <div class="tw-sidebar-section">
            <div class="tw-sidebar-heading">Failure Clusters</div>
            <div class="tw-cluster-list" role="list" aria-label="Failure cluster filters"></div>
          </div>
          <hr class="tw-sidebar-divider" />
          <div class="tw-sidebar-section">
            <div class="tw-sidebar-heading">Agents</div>
            <div class="tw-agent-list" id="tw-agent-list" style="display:flex;flex-direction:column;gap:4px;"></div>
          </div>
        </aside>

        <div class="tw-timeline-wrap" id="tw-timeline-wrap" role="main" aria-label="Agent run timeline">
          <div class="tw-timeline-header">
            <span class="tw-timeline-title">Run Timeline</span>
            <span class="tw-timeline-count tw-mono" aria-live="polite">loading…</span>
          </div>
          <div class="tw-run-cols" aria-hidden="true">
            <span class="tw-run-col">run · started</span>
            <span class="tw-run-col">agent</span>
            <span class="tw-run-col">status</span>
            <span class="tw-run-col tw-run-col--num">tokens</span>
            <span class="tw-run-col tw-run-col--num">latency</span>
          </div>
          <div class="tw-run-list" role="list" aria-label="Agent runs" aria-busy="true"></div>
        </div>

        <section class="tw-inspector tw-hidden" id="tw-inspector" aria-label="Run inspector">
          <div class="tw-inspector-header">
            <div>
              <div class="tw-inspector-run-id tw-mono">—</div>
              <div class="tw-inspector-agent"></div>
            </div>
            <button class="tw-inspector-close" aria-label="Close inspector">×</button>
          </div>
          <div class="tw-ribbon-wrap" id="tw-ribbon-wrap">
            <div class="tw-ribbon-label" style="padding:var(--tw-space-3) var(--tw-space-4)">Select a run to view trace.</div>
          </div>
          <div class="tw-inspector-body">
            <div class="tw-tree-panel" id="tw-tree-panel" role="tree" aria-label="Tool call tree"></div>
            <div class="tw-detail-panel" id="tw-detail-panel">
              <p class="tw-detail-empty">Select a step to inspect.</p>
            </div>
          </div>
        </section>
      </div>

      <div class="tw-about-section" id="tw-about">
        <button class="tw-about-toggle" id="tw-about-toggle" aria-expanded="false" aria-controls="tw-about-body">
          <span>About this demo — honest limits</span>
          <span class="tw-about-chevron" aria-hidden="true">▾</span>
        </button>
        <div class="tw-about-body" id="tw-about-body" role="region" aria-label="About Tracewell">
          <div class="tw-about-col">
            <h3>What this is</h3>
            <ul>
              <li>Portfolio demo for agent observability concepts</li>
              <li>50 synthetic runs across 3 fictional agents</li>
              <li><strong>Analyze your trace</strong> runs a real Cloudflare Function at <code>POST /tracewell/analyze</code></li>
            </ul>
          </div>
          <div class="tw-about-col">
            <h3>Honest limits</h3>
            <ul>
              <li>No live model or real agent instrumentation</li>
              <li>No persistent storage — refresh resets session state</li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <script>
      import '../components/app.ts';
    </script>
  </body>
</html>
